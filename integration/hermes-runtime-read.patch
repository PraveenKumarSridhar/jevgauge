@@ -0,0 +1,72 @@
+"""Read-only selection snapshots for standalone Desktop extensions."""
+import copy
+import pytest
+from tui_gateway import server
+
+
+def read(params):
+    return server._methods['session.runtime_selection'](1, params)
+
+
+@pytest.fixture
+def session(monkeypatch):
+    value = {'session_key':'durable', 'agent':None, 'session_route':{
+        'status':'routed', 'model':'gpt-6-luna', 'provider':'openai-codex',
+        'reasoning_effort':'low', 'owner':{'model':'router','reasoning':'router'},
+        'reason':'PRIVATE TOKEN', 'original_runtime':{'api_key':'PRIVATE TOKEN'}}}
+    monkeypatch.setitem(server._sessions,'runtime',value)
+    def forbidden(*args, **kwargs):
+        pytest.fail('read must not construct agents or access storage')
+    monkeypatch.setattr(server,'_start_agent_build',forbidden)
+    monkeypatch.setattr(server,'_session_db',forbidden)
+    yield value
+    monkeypatch.undo()
+
+
+def test_read_has_detached_allowlisted_binding_and_no_side_effects(session):
+    before=copy.deepcopy(session)
+    result=read({'session_id':'runtime','stored_session_id':'durable'})['result']
+    assert result['evidence']=='session_binding'
+    assert result['model']=='gpt-6-luna'
+    assert result['selection_api']==1
+    assert session==before
+    assert 'PRIVATE' not in str(result)
+    session['session_route']['owner']['model']='user'
+    assert result['owner']['model']=='router'
+
+
+@pytest.mark.parametrize('params', [
+    {}, {'session_id':'runtime'}, {'session_id':'runtime','stored_session_id':''},
+    {'session_id':'runtime','stored_session_id':'wrong'},
+    {'session_id':'stale','stored_session_id':'durable'},
+    {'session_id':['runtime'],'stored_session_id':'durable'},
+    {'session_id':'runtime','stored_session_id':5},
+])
+def test_rejects_missing_malformed_or_mismatched_identity(session,params):
+    assert 'error' in read(params)
+
+
+def test_sibling_scope_returns_no_route(session):
+    session['profile_home']='/disposable/sibling'
+    result=read({'session_id':'runtime','stored_session_id':'durable'})['result']
+    assert result['scope_supported'] is False
+    assert result['status']=='unsupported'
+    assert result['model'] is None
+    assert result['owner']=={'model':'default','reasoning':'default'}
+
+
+@pytest.mark.parametrize('status,owner', [('selecting','router'),('routed','user'),('unrouted/default','default')])
+def test_selecting_manual_and_fallback_are_visible_without_build_lock(session,status,owner):
+    import threading
+    session['agent_build_lock']=threading.Lock()
+    session['agent_build_lock'].acquire()
+    session['session_route']['status']=status
+    session['session_route']['owner']['model']=owner
+    result=read({'session_id':'runtime','stored_session_id':'durable'})['result']
+    assert result['status']==status
+    assert result['owner']['model']==owner
+
+
+def test_missing_record_is_unrecorded(session):
+    session.pop('session_route')
+    assert read({'session_id':'runtime','stored_session_id':'durable'})['result']['status']=='unrecorded'
