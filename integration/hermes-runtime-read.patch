 def register(server) -> None:
     """Publish this module's helpers onto ``server`` (rebound to its globals) and install handlers."""
     bind_module(globals(), server, skip=("_",))
+
+
+@method("session.runtime_selection")
+def _runtime_selection_read(rid, params: dict) -> dict:
+    # Validate before _sess_nowait: direct calls must also fail closed on non-string IDs.
+    sid, stored = params.get("session_id"), params.get("stored_session_id")
+    if not isinstance(sid, str) or not sid.strip() or not isinstance(stored, str) or not stored.strip():
+        return _err(rid, 4000, "runtime and stored session IDs are required")
+    session, err = _sess_nowait(params, rid)
+    if err:
+        return err
+    if session.get("session_key") != stored:
+        return _err(rid, 4001, "session identity mismatch")
+    # No _sess/build, DB lookup, profile config, lock wait, or transport attachment.
+    from hermes_cli import plugins
+    def capability(marker, hook):
+        version = getattr(plugins, marker, None)
+        return version if type(version) is int and hook in plugins.VALID_HOOKS else None
+    supported = not bool(session.get("profile_home"))
+    raw = session.get("session_route") if supported else None
+    route = dict(raw) if isinstance(raw, dict) else {}
+    owners = route.get("owner")
+    owners = dict(owners) if isinstance(owners, dict) else {}
+    def text(value):
+        return value if isinstance(value, str) and len(value) <= 256 and not any(ord(c) < 32 for c in value) else None
+    status = route.get("status")
+    if status not in ("selecting", "routed", "unrouted/default"):
+        status = "unrecorded"
+    return _ok(rid, {
+        "schema_version": 1, "session_id": sid, "stored_session_id": stored,
+        "evidence": "session_binding", "scope_supported": supported,
+        "selection_api": capability("SESSION_RUNTIME_SELECTION_API", "select_session_runtime"),
+        "telemetry_api": capability("PROVIDER_ATTEMPT_API", "provider_attempt"),
+        "status": status if supported else "unsupported",
+        "model": text(route.get("model")), "provider": text(route.get("provider")),
+        "reasoning_effort": text(route.get("reasoning_effort")),
+        "owner": {key: owners.get(key) if owners.get(key) in ("router", "user") else "default"
+                  for key in ("model", "reasoning")},
+    })
