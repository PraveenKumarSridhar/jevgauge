@@ -0,0 +1,42 @@
+import { fireEvent, render, screen } from '@testing-library/react'
+import { describe, expect, it } from 'vitest'
+
+import { RouteDecision } from './session-route-panel'
+
+describe('routing decision display', () => {
+  it('minimizes, remembers the preference, and reopens without changing the route', () => {
+    const route = { status: 'routed', label: 'JevGauge', model: 'test-model', reasoning_effort: 'low' }
+    const first = render(<RouteDecision route={route} />)
+    fireEvent.click(screen.getByRole('button', { name: 'Minimize routing details' }))
+    expect(screen.queryByText('MODEL · AUTO')).toBeNull()
+    expect(window.localStorage.getItem('hermes.desktop.routeDetailsExpanded.v1')).toBe('false')
+    first.unmount()
+    render(<RouteDecision route={route} />)
+    expect(screen.getByRole('button', { name: 'Expand routing details' }).getAttribute('aria-expanded')).toBe('false')
+    fireEvent.click(screen.getByRole('button', { name: 'Expand routing details' }))
+    expect(screen.getByText('MODEL · AUTO')).toBeTruthy()
+    expect(route.model).toBe('test-model')
+  })
+  it('shows progress then independent manual and automatic decisions', () => {
+    const { rerender } = render(<RouteDecision route={{ status: 'selecting', label: 'JevGauge' }} />)
+    expect(screen.getByText('● CHOOSING')).toBeTruthy()
+    rerender(
+      <RouteDecision
+        route={{
+          status: 'routed',
+          label: 'JevGauge',
+          model: 'test-model',
+          reasoning_effort: 'high',
+          owner: { model: 'router', reasoning: 'user' }
+        }}
+      />
+    )
+    expect(screen.queryByText('● CHOOSING')).toBeNull()
+    expect(screen.getByText('test-model')).toBeTruthy()
+    expect(screen.getByText('REASONING · MANUAL')).toBeTruthy()
+    rerender(<RouteDecision route={{ status: 'unrouted/default', model: 'original' }} />)
+    expect(screen.getByText('● DEFAULTS RETAINED')).toBeTruthy()
+    rerender(<RouteDecision route={null} />)
+    expect(screen.queryByLabelText('Session routing')).toBeNull()
+  })
+})
