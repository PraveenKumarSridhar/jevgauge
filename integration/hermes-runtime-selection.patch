@@ -0,0 +1,94 @@
+import { useStore } from '@nanostores/react'
+import { computed } from 'nanostores'
+import { useMemo } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { $routeDetailsExpanded } from '@/store/session-route-display'
+import { $sessionStates } from '@/store/session-states'
+
+const text = (value: unknown, fallback = '') => (typeof value === 'string' ? value : fallback)
+
+export function RouteDecision({ route }: { route?: Record<string, unknown> | null }) {
+  const expanded = useStore($routeDetailsExpanded)
+
+  if (!route) {
+    return null
+  }
+
+  const selecting = route.status === 'selecting'
+  const fallback = route.status === 'unrouted/default'
+  const owner = route.owner && typeof route.owner === 'object' ? (route.owner as Record<string, unknown>) : {}
+  const effort = text(route.reasoning_effort, 'Profile default')
+  const depth = ['low', 'medium', 'high'].indexOf(effort) + 1
+
+  return (
+    <section aria-label="Session routing" aria-live="polite" className="mx-auto w-full max-w-3xl shrink-0 px-6 py-3">
+      <div className="border-l-2 border-current pl-4">
+        <div className="flex items-center justify-between gap-3 font-mono text-xs">
+          <span className="font-semibold tracking-widest">{text(route.label, 'Session routing')}</span>
+          <span className={selecting ? 'motion-safe:animate-pulse opacity-70' : 'opacity-60'}>
+            {selecting ? '● CHOOSING' : fallback ? '● DEFAULTS RETAINED' : '● ROUTE SELECTED'}
+          </span>
+          <Button
+            aria-expanded={expanded}
+            aria-label={expanded ? 'Minimize routing details' : 'Expand routing details'}
+            onClick={() => $routeDetailsExpanded.set(!expanded)}
+            variant="text"
+          >
+            {expanded ? 'Minimize ↑' : 'Details ↓'}
+          </Button>
+        </div>
+        {!expanded && !selecting && (
+          <p className="mt-1 truncate font-mono text-xs opacity-60">
+            {text(route.model, 'Profile default')} · {effort}
+          </p>
+        )}
+        {expanded &&
+          (selecting ? (
+            <p className="mt-3 text-sm opacity-70">
+              Evaluating your prompt. Choosing model capacity and reasoning depth independently.
+            </p>
+          ) : (
+            <div className="mt-3 grid grid-cols-2 gap-4">
+              <div>
+                <div className="text-xs opacity-50">
+                  MODEL · {owner.model === 'user' ? 'MANUAL' : fallback ? 'DEFAULT' : 'AUTO'}
+                </div>
+                <div className="mt-1 truncate font-mono text-sm">{text(route.model, 'Profile default')}</div>
+              </div>
+              <div>
+                <div className="text-xs opacity-50">
+                  REASONING · {owner.reasoning === 'user' ? 'MANUAL' : fallback ? 'DEFAULT' : 'AUTO'}
+                </div>
+                <div className="mt-1 flex items-center gap-3 font-mono text-sm">
+                  <span className="capitalize">{effort}</span>
+                  <span aria-hidden="true" className="flex gap-1">
+                    {[1, 2, 3].map(level => (
+                      <span
+                        className={`h-2 w-6 rounded-sm bg-current ${level <= depth ? 'opacity-80' : 'opacity-15'}`}
+                        key={level}
+                      />
+                    ))}
+                  </span>
+                </div>
+              </div>
+            </div>
+          ))}
+        {expanded && !selecting && (
+          <p className="mt-2 truncate font-mono text-xs opacity-50">
+            {text(route.provider)} · {text(route.reason)} · Conversation binding
+          </p>
+        )}
+      </div>
+    </section>
+  )
+}
+
+export function SessionRoutePanel({ sessionId }: { sessionId: string | null }) {
+  const store = useMemo(
+    () => computed($sessionStates, states => (sessionId ? states[sessionId]?.sessionRoute : null)),
+    [sessionId]
+  )
+
+  return <RouteDecision route={useStore(store)} />
+}
