+"""Permanent model changes retain explicit effort and publish the effective route."""
+import copy
+from types import SimpleNamespace
+
+import pytest
+import tui_gateway.server as server
+
+
+@pytest.fixture
+def switch_case(monkeypatch):
+    class Agent:
+        model, provider, base_url, api_key, api_mode = "gpt-6-luna", "openai-codex", "", "", ""
+        reasoning_config = {"enabled": True, "effort": "high"}
+        calls = 0
+
+        def switch_model(self, **kwargs):
+            self.calls += 1
+            self.model, self.provider = kwargs["new_model"], kwargs["new_provider"]
+            self.reasoning_config = {"enabled": True, "effort": "medium"}
+
+    agent = Agent()
+    session = {"agent": agent, "session_route": {
+        "model": agent.model, "provider": agent.provider, "reasoning_effort": "high",
+        "owner": {"model": "router", "reasoning": "user"}},
+        "create_reasoning_override": copy.deepcopy(agent.reasoning_config)}
+    result = SimpleNamespace(success=True, new_model="gpt-6-sol", target_provider="openai-codex",
+                             base_url="", api_key="", api_mode="codex_responses", warning_message="",
+                             model_info=None, runtime_capabilities=None)
+    monkeypatch.setattr("hermes_cli.model_switch.switch_model", lambda **kw: result)
+    for name in ("_restart_slash_worker", "_persist_live_session_system_prompt", "_append_model_switch_marker",
+                 "_merge_preflight_warning"):
+        monkeypatch.setattr(server, name, lambda *a, **kw: None)
+    events = []
+    saved = []
+    monkeypatch.setattr(server, "_emit_session_info", lambda *a: events.append(copy.deepcopy(session["session_route"])))
+    monkeypatch.setattr(server, "_persist_live_session_runtime", lambda *a: saved.append((
+        copy.deepcopy(agent.reasoning_config), copy.deepcopy(session["session_route"]))))
+    return agent, session, result, events, saved
+
+
+@pytest.mark.parametrize("owner,once,expected", [("user", False, "high"), ("router", False, "medium"),
+                                                ("user", True, "medium")])
+def test_switch_publishes_and_persists_effective_effort(switch_case, owner, once, expected):
+    agent, session, result, events, saved = switch_case
+    session["session_route"]["owner"]["reasoning"] = owner
+    old_route = copy.deepcopy(session["session_route"])
+    server._apply_model_switch("s", session, "gpt-6-sol " + ("--once" if once else "--session"),
+                               confirm_expensive_model=True)
+    assert agent.reasoning_config["effort"] == expected
+    if once:
+        assert session["session_route"] == old_route
+        assert session["one_turn_model_restore"]["reasoning_config"]["effort"] == "high"
+    else:
+        assert session["session_route"]["reasoning_effort"] == expected
+        assert events[-1]["reasoning_effort"] == expected
+        assert saved[-1][0]["effort"] == saved[-1][1]["reasoning_effort"] == expected
+        assert session["create_reasoning_override"]["effort"] == expected
+
+
+@pytest.mark.parametrize("explicit", [False, True])
+def test_incompatible_manual_pair_is_rejected_before_mutation(switch_case, explicit):
+    agent, session, result, events, saved = switch_case
+    result.new_model = "gpt-6-astra"
+    agent.reasoning_config = {"enabled": False}
+    session["create_reasoning_override"] = {"enabled": False}
+    session["session_route"]["reasoning_effort"] = "none"
+    original = copy.deepcopy(session["session_route"])
+    command = "gpt-6-astra --session" + (" --reasoning none" if explicit else "")
+    with pytest.raises(ValueError, match="reasoning.*none.*gpt-6-astra"):
+        server._apply_model_switch("s", session, command, confirm_expensive_model=True)
+    assert agent.calls == 0
+    assert session["session_route"] == original
+    assert not events and not saved
+
+
+@pytest.mark.parametrize("owner,explicit,expected", [("router", "", "medium"),
+                                                    ("user", "", "high"),
+                                                    ("router", "high", "high"), ("router", "", None)])
+def test_deferred_switch_updates_build_event_and_existing_row(switch_case, monkeypatch, owner, explicit, expected):
+    import json
+    _, session, result, _, _ = switch_case
+    result.api_mode = ""
+    session.update(agent=None, session_key="saved-chat", source="desktop")
+    session["session_route"]["owner"]["reasoning"] = owner
+    session["resume_runtime_overrides"] = {
+        "model_override": {"model": "gpt-6-luna", "provider": "openai-codex"},
+        "provider_override": "openai-codex", "reasoning_config_override": {"enabled": True, "effort": "high"}}
+    session.pop("create_reasoning_override")  # cold resume stores effort in resume overrides
+    monkeypatch.setattr(server, "_current_model_runtime", lambda *a: ("openai-codex", "gpt-6-luna", "", ""))
+    monkeypatch.setattr(server, "_load_reasoning_config", lambda *a: None if expected is None else {"enabled": True, "effort": "medium"})
+    row = {"model": "gpt-6-luna", "model_config": json.dumps({"service_tier": "priority", "base_url": "https://old-endpoint.invalid/v1",
+                  "api_mode": "old_mode", "reasoning_config": {"enabled": True, "effort": "high"}})}
+    class DB:
+        def get_session(self, key):
+            return row
+        def update_session_meta(self, key, config, model):
+            row.update(model=model, model_config=config)
+    monkeypatch.setattr(server, "_profile_session_db", lambda *a: (DB(), False))
+    emitted = []
+    monkeypatch.setattr(server, "_emit", lambda kind, sid, payload: emitted.append(payload))
+    server._apply_model_switch("s", session, "gpt-6-sol --session" + (f" --reasoning {explicit}" if explicit else ""),
+                               confirm_expensive_model=True)
+    build = server._deferred_build_agent_kwargs(session, None)
+    assert build["model_override"]["model"] == "gpt-6-sol"
+    assert (build["reasoning_config_override"] or {}).get("effort") == expected
+    assert session["session_route"]["reasoning_effort"] == expected
+    assert emitted[-1]["session_route"]["reasoning_effort"] == expected
+    saved = json.loads(row["model_config"])
+    assert row["model"] == "gpt-6-sol"
