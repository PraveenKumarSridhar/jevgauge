+def _finish_deferred_route_switch(sid: str, session: dict, result, reasoning_override) -> None:
+    """Keep the cold-resume build, saved binding, and panel on the same permanent pair."""
+    _invalidate_session_route_fallback(session)
+    reasoning = copy.deepcopy(reasoning_override if reasoning_override is not None
+                              else _load_reasoning_config(result.new_model))
+    session["create_reasoning_override"] = reasoning
+    model_override = {"model": result.new_model, "provider": result.target_provider,
+                      "base_url": result.base_url, "api_key": result.api_key, "api_mode": result.api_mode}
+    session["model_override"] = model_override
+    if isinstance(session.get("resume_runtime_overrides"), dict):
+        session["resume_runtime_overrides"].update(
+            model_override=model_override, provider_override=result.target_provider,
+            reasoning_config_override=reasoning)
+    route = session["session_route"]
+    route.update(model=result.new_model, provider=result.target_provider, reasoning_effort=_switch_effort(reasoning))
+    owners = route.setdefault("owner", {})
+    owners["model"] = "user"
+    if reasoning_override is None:
+        owners["reasoning"] = "default"
+    _publish_deferred_route_runtime(sid, session)
+
+
+def _publish_deferred_route_runtime(sid: str, session: dict) -> None:
+    """Publish a deferred routed binding after either model or reasoning changes."""
+    route = session["session_route"]
+    # Persist an existing conversation, but never turn a draft into a saved empty chat.
+    if key := session.get("session_key"):
+        db, owns_db = _profile_session_db(session.get("profile_home"))
+        try:
+            if db is not None and (row := db.get_session(key)):
+                old = _parse_model_config(row.get("model_config"))
+                # Sparse serialization omits cleared runtime fields. Remove the prior
+                # binding first so an empty new endpoint/effort cannot revive on resume.
+                for field in ("model", "provider", "base_url", "api_mode", "reasoning_config"):
+                    old.pop(field, None)
+                model, config = _workdir_row_model_config(session)
+                db.update_session_meta(key, json.dumps({**old, **config}), model)
+        finally:
+            if owns_db:
+                _release_db(db)
+    _emit("session.info", sid, {"session_route": copy.deepcopy(route), "model": route.get("model") or "",
+                                "provider": route.get("provider") or "", "reasoning_effort": route.get("reasoning_effort") or ""})
+
+
